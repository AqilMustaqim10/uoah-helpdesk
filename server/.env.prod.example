# PRODUCTION environment — copy to server/.env.prod and fill in real values.
# Generate secrets with:  npx tsx src/scripts/gensecrets.ts
# NEVER reuse UAT secrets here.

NODE_ENV=production
PORT=3000
CLIENT_ORIGIN=https://helpdesk.yourcompany.com.my
APP_URL=https://helpdesk.yourcompany.com.my

# Production options (IIS terminates HTTPS and proxies to this local listener)
BIND_ADDRESS=127.0.0.1
TRUST_PROXY=1
REQUIRE_HTTPS=true
SERVE_CLIENT=true
CLIENT_DIST=../client/dist

# Database (PROD)
DATABASE_URL=postgres://helpdesk_app:CHANGE_ME@localhost:5432/uoa_helpdesk

# Optional AI
GEMINI_API_KEY=
GEMINI_PRIORITY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Secrets (generate a fresh set for PROD — different from UAT)
JWT_SECRET=
CODE_HMAC_SECRET=
MFA_ENCRYPTION_KEY=

ALLOWED_SENDER_DOMAINS=yourcompany.com.my

UPLOAD_DIR=./uploads

# Outgoing mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UOA IT Helpdesk <helpdesk@yourcompany.com.my>"

# Incoming mail
POP3_HOST=
POP3_PORT=995
POP3_TLS=true
POP3_USER=
POP3_PASS=
INGEST_INTERVAL_SECONDS=10

# First admin (delete these three lines after npm run seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=

# Backups — put BACKUP_DIR on a different drive
BACKUP_DIR=D:\helpdesk-backups
BACKUP_KEEP_DAYS=14
BACKUP_DATABASE_URL=postgres://helpdesk_backup:CHANGE_ME@localhost:5432/uoa_helpdesk
BACKUP_PASSPHRASE=
BACKUP_ALERT_EMAIL=
PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin