# Copy this file to ".env" and fill in real values. NEVER commit ".env" (it holds your secrets).
# Generate strong secrets with:  npm run secrets:generate

NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Production only (see README, section 6):
# BIND_ADDRESS=127.0.0.1
# TRUST_PROXY=1
# REQUIRE_HTTPS=true
# SERVE_CLIENT=true
# CLIENT_DIST=../client/dist

# Database: the LIMITED role helpdesk_app (letters and digits only in the password)
DATABASE_URL=postgres://helpdesk_app:CHANGE_ME@localhost:5432/uoa_helpdesk

# Secrets
JWT_SECRET=
CODE_HMAC_SECRET=
MFA_ENCRYPTION_KEY=

# Only these email domains may register, be added by an administrator, or get replies from the worker
ALLOWED_SENDER_DOMAINS=yourcompany.com.my

UPLOAD_DIR=./uploads

# Outgoing mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UOA IT Helpdesk <helpdesk@yourcompany.com.my>"

# Incoming mail (a mailbox used ONLY by the helpdesk). Port 995 = TLS (true), port 110 = plain (false).
POP3_HOST=
POP3_PORT=995
POP3_TLS=true
POP3_USER=
POP3_PASS=
# POP3_IGNORE_TLS_ERRORS=false
INGEST_INTERVAL_SECONDS=10

# First administrator (used once by "npm run seed"; delete these three lines afterwards)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=First Administrator
SEED_ADMIN_PASSWORD=

# Backups (see README, section 7). BACKUP_DIR must be OUTSIDE the project folder.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
BACKUP_DATABASE_URL=postgres://helpdesk_backup:CHANGE_ME@localhost:5432/uoa_helpdesk
BACKUP_PASSPHRASE=
BACKUP_ALERT_EMAIL=
PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin