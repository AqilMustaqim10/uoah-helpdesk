# UAT environment — copy to server/.env.uat and fill in real values.
# Generate secrets with:  npx tsx src/scripts/gensecrets.ts

NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=http://localhost:3000,https://uat-helpdesk.yourcompany.com.my
APP_URL=https://uat-helpdesk.yourcompany.com.my

# Production-style options (safe for UAT)
BIND_ADDRESS=0.0.0.0
TRUST_PROXY=1
REQUIRE_HTTPS=true
SERVE_CLIENT=true
CLIENT_DIST=../client/dist

# Database (UAT)
DATABASE_URL=postgres://helpdesk_app:CHANGE_ME@localhost:5432/uoa_helpdesk_uat

# Optional AI
GEMINI_API_KEY=
GEMINI_PRIORITY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Secrets (generate a fresh set for UAT)
JWT_SECRET=
CODE_HMAC_SECRET=
MFA_ENCRYPTION_KEY=

ALLOWED_SENDER_DOMAINS=yourcompany.com.my

UPLOAD_DIR=./uploads

# Outgoing mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UOA IT Helpdesk (UAT) <helpdesk-uat@yourcompany.com.my>"

# Incoming mail (optional for UAT)
POP3_HOST=
POP3_PORT=995
POP3_TLS=true
POP3_USER=
POP3_PASS=
INGEST_INTERVAL_SECONDS=10

# First admin (delete these three lines after npm run seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=UAT Administrator
SEED_ADMIN_PASSWORD=

# Backups (optional on UAT)
BACKUP_DIR=
BACKUP_KEEP_DAYS=7
BACKUP_DATABASE_URL=postgres://helpdesk_backup:CHANGE_ME@localhost:5432/uoa_helpdesk_uat
BACKUP_PASSPHRASE=
BACKUP_ALERT_EMAIL=
PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin